if __name__ == "__main__":
    print("Oddiy ko'phad sinfi testi:")
    poly = KO_PHAD([1, 2, 3])  # 1 + 2x + 3x^2
    poly.print_polynomial()
    print(f"x=2.0 uchun qiymat: {poly.evaluate(2.0):.2f}")
    
    print("\nChebishev ko'phadi sinfi testi:")
    k = int(input("Chebishev ko'phadi tartibini kiriting (k >= 0): "))
    cheb = SHEBISHEV(k)
    print(f"T{k}(x) ko'phadi:")
    cheb.print_polynomial()
    
    x = float(input("Ko'phad qiymatini hisoblash uchun x ni kiriting: "))
    print(f"T{k}({x}) = {cheb.evaluate(x):.4f}")
