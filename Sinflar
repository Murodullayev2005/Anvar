class KO_PHAD:
    def __init__(self, daraja, koeffitsientlar):

        self.daraja = daraja
        self.koeffitsientlar = koeffitsientlar

        # Agar koeffitsientlar soni darajadan birga ko'p bo'lmasa, xato
        if len(self.koeffitsientlar) != self.daraja + 1:
            raise ValueError("Koeffitsientlar soni daraja + 1 ga teng bo'lishi kerak")

    def qiymat(self, x):
        natija = 0
        for i in range(self.daraja + 1):
            natija += self.koeffitsientlar[i] * (x ** (self.daraja - i))
        return natija

    def __str__(self):
        if self.daraja == 0:
            return str(self.koeffitsientlar[0])

        terms = []
        for i in range(len(self.koeffitsientlar)):
            power = self.daraja - i
            coeff = self.koeffitsientlar[i]

            if coeff == 0:
                continue

            if power == 0:
                term = f"{coeff}"
            elif power == 1:
                term = f"{coeff}x" if coeff != 1 else "x"
            else:
                term = f"{coeff}x^{power}" if coeff != 1 else f"x^{power}"

            terms.append(term)

        return " + ".join(terms).replace("+ -", "- ")

