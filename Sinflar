if __name__ == "__main__":
    # 2x^3 + 3x^2 + 4x + 5 ko'phadi
    k1 = KO_PHAD(3, [2, 3, 4, 5])
    print(f"Ko'phad: {k1}")
    x = 2
    print(f"Ko'phadning x={x} dagi qiymati: {k1.qiymat(x)}")

    # x^2 - 2x + 1 ko'phadi
    k2 = KO_PHAD(2, [1, -2, 1])
    print(f"\nKo'phad: {k2}")
    x = 1
    print(f"Ko'phadning x={x} dagi qiymati: {k2.qiymat(x)}")

